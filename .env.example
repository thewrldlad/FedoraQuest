# Firebase project config — copy this file to .env and fill in real
# values from the Firebase Console: Project Settings > General > Your apps
# > SDK setup and configuration > Config.
#
# These are safe to expose in client-side code (Firebase web API keys are
# not secrets — access is controlled by Firestore/Storage security rules,
# not by hiding this config), but never commit the real .env file anyway.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
